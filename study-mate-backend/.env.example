PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/preppulse_ai
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Deployable open-weight AI options
# fallback = deterministic demo-safe responses and quiz bank
# groq = hosted open-weight models such as Llama
# huggingface = HuggingFace Inference API models
AI_PROVIDER=fallback
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
HF_API_TOKEN=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Embedding model name kept for future vector DB/RAG upgrade
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
